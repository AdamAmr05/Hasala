                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": 150,\n    \"description\": \"Groceries\",\n    \"category\": \"Food\",\n    \"type\": \"EXPENSE\",\n    \"date\": \"2023-10-27T10:00:00.000Z\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/transactions",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Transaction",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": 200,\n    \"description\": \"Updated Groceries\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/transactions/:id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "REPLACE_WITH_TX_ID"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Transaction",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/transactions/:id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "REPLACE_WITH_TX_ID"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Analytics",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/transactions/analytics?period=30",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions",
                                "analytics"
                            ],
                            "query": [
                                {
                                    "key": "period",
                                    "value": "30"
                                }
                            ]
