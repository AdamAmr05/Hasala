        {
            "name": "Transactions",
            "item": [
                {
                    "name": "Get All Transactions",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/transactions?page=1&limit=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Transaction (ID)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/transactions/:id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "transactions",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "REPLACE_WITH_TX_ID"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Add Transaction",
                    "request": {
                        "method": "POST",
                        "header": [
